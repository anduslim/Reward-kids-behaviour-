# Family-group leaderboard (optional). Without these the app runs fully offline
# and the Leaderboard page shows its "coming soon / setup" state.
#
# Copy to .env.local for local dev, and set the same as:
#   - GitHub repo secrets (used by .github/workflows/deploy.yml)
#   - Vercel project environment variables
#
# Values come from your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
